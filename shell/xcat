#!/bin/bash

set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: $0 FILE" >&2
    exit 1
fi

# Last argument (only works in bash)
file="${@: -1}"

case "$file" in
    *.gz)   gzip   -dc "$@" ;;
    *.bz2)  bzip2  -dc "$@" ;;
    *.xz)   xz     -dc "$@" ;;
    *.zst)  zstd   -dc "$@" ;;
    *.lz4)  lz4    -dc "$@" ;;
    *.br)   brotli -dc "$@" ;;
    *)      cat "$@" ;;
esac
